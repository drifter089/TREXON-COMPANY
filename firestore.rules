rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // contact_submissions: public users can CREATE only.
    // No reads, updates, or deletes from the client (admin SDK / console only).
    match /contact_submissions/{docId} {
      allow read, update, delete: if false;

      allow create: if
        // Required string fields with sane length bounds
        request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('.+@.+\\..+')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2500
        // Source must be one of our known intake points
        && request.resource.data.source is string
        && request.resource.data.source in ['contact-page', 'closing-cta']
        // Server timestamp must be present (clients pass serverTimestamp())
        && 'createdAt' in request.resource.data
        // Total document size hard cap (defense-in-depth against fat payloads)
        && request.resource.size() < 20;
    }

    // Default-deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
